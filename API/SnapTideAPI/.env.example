# SnapTide 백엔드 환경변수 예시
# 실제 값으로 채운 뒤, 셸에서 export 하거나 IDE 실행 구성의 Environment variables 에 등록하세요.
# (이 파일은 커밋용 예시입니다. 실제 비밀 값이 담긴 .env 는 커밋하지 마세요.)

# --- Database (MariaDB) ---
DB_URL=jdbc:mariadb://localhost:3306/db7
DB_USERNAME=db7
DB_PASSWORD=여기에_DB_비밀번호

# --- JWT ---
# 운영 환경에서는 반드시 32바이트(256비트) 이상의 무작위 문자열로 교체하세요.
JWT_SECRET=최소_32자_이상의_무작위_시크릿_문자열
JWT_EXPIRE_MINUTES=43200

# --- File upload ---
# 미설정 시 기본값: <사용자 홈>/snaptide-uploads
UPLOAD_PATH=

# --- Server ---
SERVER_PORT=8080
